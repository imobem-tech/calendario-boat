{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "echo 'No build needed'",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/rastrear", "destination": "/rastrear.html" },
    { "source": "/rastrear.html", "destination": "/rastrear.html" },
    { "source": "/agendar", "destination": "/agendar.html" },
    { "source": "/agendar.html", "destination": "/agendar.html" },
    { "source": "/visualizar-orcamento.html", "destination": "/visualizar-orcamento.html" },
    { "source": "/((?!api).*)", "destination": "/index.html" }
  ]
}
